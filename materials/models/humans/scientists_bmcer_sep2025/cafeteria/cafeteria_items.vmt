"VertexLitGeneric"
{
	"$baseTexture" "models\humans\scientists_bmcer_sep2025/cafeteria/cafeteria_items"
	"$bumpmap" "models\humans\scientists_bmcer_sep2025/cafeteria/cafeteria_items_normal"
	"$model" "1"
	"$surfaceprop" "flesh"

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponenttexture" "models/humans/male_exponent"
	"$phongboost"	".3" //.25
	"$phongfresnelranges"	"[0.05 0.5 1]"
	"$phongexponent"	"2"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".25"	 //.4              // Boost for ambient cube component of rim lighting
}
