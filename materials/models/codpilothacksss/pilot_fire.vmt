"VertexLitGeneric"
{
	"$baseTexture" "models\CODpilothacksss/pilot_fire"
	"$bumpmap" "models\CODpilothacksss/pilot_normal"
	"$nocull" 0
	"$phong" "1"
	"$phongexponent" "5" //8
	"$phongboost" ".05"	
	"$phongfresnelranges"	"[.3 1 8]"
	"$halflambert" "0"

	// Rim lighting parameters
	"$rimlight" "0"												// To enable rim lighting (requires phong)
	"$rimlightexponent" "4"										// Exponent for phong component of rim lighting	
	"$rimlightboost" ".1"	
	
	$detail models\humans\guards/clothes
	$detailscale 3.25
	$detailblendfactor 0.5
	$detailblendmode 0
}
