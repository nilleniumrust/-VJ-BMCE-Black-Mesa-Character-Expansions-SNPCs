"VertexlitGeneric"
{
	"$baseTexture" "models\zombies_bmcer_sep2025/zcleansuit"
	"$bumpmap" "models/humans/scientists_bmcer_sep2025/cleansuit/body_cleansuit_n"
	"$surfaceprop" "flesh"

	"$selfillum" "1"
	"$selfillummask" "models/humans/scientists_bmcer_sep2025/cleansuit/body_selfillummask"

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponenttexture" "models/humans/scientists_bmcer_sep2025/cleansuit/cleansuit_exponent"
	"$phongexponent" "25"
	"$phongboost"	"1.25" //5
	"$phongfresnelranges"	"[0.5 0.65 1]"
//	"$phongfresnelranges" "[0 .5 1]"
	"$halflambert" "0"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "33"		// Exponent for phong component of rim lighting
	"$rimlightboost" "1"	               // Boost for ambient cube component of rim lighting

//	$detail "effects/models/model_blood_red.vtf"
	$detailscale 5
	$detailblendfactor 0.0
	$detailblendmode 0
	Proxies
	{
		ModelDetailFx
		{
		}
	}

	"$model" "1"
	
	"$normalmapalphaenvmapmask"	"1"
	"$envmap" 					"env_cubemap"
	"$envmaptint" 				"[ 0.025 0.025 0.025 ]"
}

