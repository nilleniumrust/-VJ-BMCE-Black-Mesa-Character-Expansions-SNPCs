"VertexLitGeneric"
{
	"$baseTexture" "models\humans/admin_bmcer_sep2025/tiesandties"
//	"$bumpmap" "models/humans/admin_bmcer_sep2025/normalmap_flat"

$bumpmap "effects/flat_normal"

	"$detail" "models\ninja_bmcer_sep2025/L4D2/clothes_detail"
	"$detailscale" 2
	"$detailblendfactor" 1
	"$detailblendmode" 0
	
        $phong 1
        $phongexponent 20 //7
        $phongboost 2 //.1
//        $phongtint "[1 1 1]"
        $halflambert 0
        $phongfresnelranges "[.4 .8 30]"
	"$phongalbedotint" "1"		
	"$phongexponenttexture" "models\ninja_bmcer_sep2025/L4D2/exp_tie"
		
// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".1"	               // Boost for ambient cube component of rim lighting
}
