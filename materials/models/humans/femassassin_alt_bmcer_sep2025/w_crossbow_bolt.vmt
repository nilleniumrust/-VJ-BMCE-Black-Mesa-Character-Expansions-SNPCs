"$rimlight" "1"
"$rimlightexponent" "10"
"$rimlightboost" "1"
    "$model" 1

	"$cloakpassenabled" "1"
	"$refractamount" "1"

	"Proxies"
	{
		"AssassinCloak"
		{
			"resultVar" "$cloakfactor"
		}

		"AssassinCloak"
		{
			"resultVar" "$refractamount"
		}
	}
}