//"EDITOR_SHADER"
"VertexLitGeneric"
{
"$SHADERNAME" "model_standard"

	"$baseTexture" "models/world_models/w_weaponbox"
	"$bumpmap" "models/world_models/w_weaponbox_norm"

	"$envmap" "env_cubemap"
        "$normalmapalphaenvmapmask" 1
	"$envmaptint" "[.54 .54 .54]"

	"$selfillum" 1
	"$selfillumtint" "[16 4.8 1.6]"

        "$detail" "detail\bm_metal_detail_01"
