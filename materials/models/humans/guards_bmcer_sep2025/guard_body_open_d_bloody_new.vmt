"VertexLitGeneric"
{
	"$baseTexture" "models\humans\guards_bmcer_sep2025/guard_body_open_d_bloody_new"
        "$bumpmap" "models\humans\guards_bmcer_sep2025/guard_body_open_n_new"
	"$surfaceprop" "flesh"

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
        $phong 1
        $phongexponent 7
        $phongboost 2
        $phongtint "[1 1 1]"
        $halflambert 0
        $phongfresnelranges "[.4 .8 30]"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".1"	//3               // Boost for ambient cube component of rim lighting

	$detail models\humans\guards_bmcer_sep2025/clothes
	$detailscale "[ 5 10 ]"
	$detailblendfactor 0.4
	$detailblendmode 0
	Proxies
	{
		ModelDetailFx
		{
		}
	}
	
	
	"$model" 1
	
}
