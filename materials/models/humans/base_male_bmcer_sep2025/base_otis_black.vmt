"VertexLitGeneric"
{
	"$baseTexture" "models\humans\base_male_bmcer_sep2025/Base_Otis_black"
	"$bumpmap" "models\humans\base_male_bmcer_sep2025/base_m_16_n"
        "$lightwarptexture" "models\humans\base_male_bmcer_sep2025\Base_M_caucasian_wrp"
//        "$lightwarptexture" "models\humans\base_male_bmcer_sep2025\Base_M_african_wrp"
        $halflambert 0
	"$nodecal" "1"
	"$model" "1"
	"$surfaceprop" "flesh"

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
        $phong 1
        $phongboost "1.4"
	$phongexponenttexture "models/humans/male_exponent"
        $phongtint "[.85 .85 1]"
        $phongfresnelranges "[.2 .5 5]"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".5"	               // Boost for ambient cube component of rim lighting
	
	"$detail" "models\humans\base_male_bmcer_sep2025\skin"
	"$detailscale"        "8"
	"$detailblendfactor"  ".55"
	"$detailblendmode"    "0"
}
