	"$phong" "1"
	"$phongexponent" "48"
	"$phongboost" ".8"
	"$phongfresnelranges"	"[0.1 1.3 9.6]"
	"$phongalbedotint" "1"

	"$halflambert"			"1"
	"$rimlight"               "1"
	"$rimlightexponent"       "200"
	"$rimlightboost"          ".1"
	//"$rimmask"			"1"

// 	$detail "effects/models/model_blood_red.vtf"
	$detailscale 5
	$detailblendfactor 0.0
	$detailblendmode 0
