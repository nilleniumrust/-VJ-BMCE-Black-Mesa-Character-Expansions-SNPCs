"VertexLitGeneric"
{
	"$baseTexture" "models\humans\remade_zombies_bmcer_sep2025/zombie_shared"
	"$bumpmap" "models\humans\remade_zombies_bmcer_sep2025/zombie_shared_n"
	"$model" "1"
	"$surfaceprop" "flesh"
	"$nocull" 1

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponenttexture" "models/humans/male_exponent"
	"$phongboost"	".25"
	"$phongfresnelranges"	"[0.05 0.5 1]"
   // "$lightwarptexture" 	"models\ninja_bmcer_sep2025/L4D2/Clothes_wrp"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".4"	               // Boost for ambient cube component of rim lighting

//	$detail "effects/models/model_blood_red.vtf"
//	"$detail" "models\ninja_bmcer_sep2025/L4D2/clothes_detail"
//	"$detailscale" 10
//	"$detailblendfactor" .5
//	"$detailblendmode" 0

	$detail models\humans\guards_bmcer_sep2025/clothes
	$detailscale "[10 5]"
	$detailblendfactor 0.4
	$detailblendmode 0
}
