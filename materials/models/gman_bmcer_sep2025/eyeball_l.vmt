"EyeRefract"
{
	"$Iris"               "models/Gman_bmcer_sep2025/eye-iris-greenleft"			  // Iris color in RGB with cornea noise in A
	"$AmbientOcclTexture" "models/Gman_bmcer_sep2025/eye-extra"				  // Ambient occlusion in RGB, A unused
	"$Envmap"             "models/Gman_bmcer_sep2025/eye-reflection-cubemap-"    // Reflection environment map
	"$CorneaTexture"      "models/Gman_bmcer_sep2025/eye-cornea"                 // Special texture that has 2D cornea normal in RG and other data in BA

	"$EyeballRadius" "0.5"				// Default 0.5
	"$AmbientOcclColor" "[0.5 0.5 0.5]"	// Default 0.33, 0.33, 0.33
	"$Dilation" "0.7"					// Default 0.5
	"$ParallaxStrength" "0.5"          // Default 0.25
	"$CorneaBumpStrength" ".5"			// Default 1.0

	"$halflambert" "1"
	"$nodecal" "1"

	// These effects are only available in ps.2.0b and later
	"$RaytraceSphere" "0"				// Default 1 - Enables raytracing in the pixel shader to make the eyeball look round
	"$SphereTexkillCombo" "0"			// Default 1 - Enables killing pixels that don't ray-intersect the sphere
}