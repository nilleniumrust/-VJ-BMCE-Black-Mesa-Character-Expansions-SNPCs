VertexLitGeneric
{
	$basetexture "models/weapons/v_satchel/c4_satchel_sheet"
	$bumpmap "models/weapons/v_satchel/c4_satchel_normal"
	$surfaceprop Paper

	$detail "detail/detail_noise1"
	$detailscale 8

	$phong 1
	$phongfresnelranges "[0.5 0.75 1]"
	$phongtint "[0.64 0.64 0.64]"
	$phongexponent 450
	$phongboost 1.01
	$phongalbedoboost 1.01

	%keywords "bshift"

	$model 1
}