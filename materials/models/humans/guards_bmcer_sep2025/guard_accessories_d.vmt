"VertexLitGeneric"
{
	"$baseTexture" "models\humans\guards_bmcer_sep2025/guard_accessories_d"       
        "$bumpmap" "models\humans\guards_bmcer_sep2025/guard_accessories_n"
        "$surfaceprop" "metal"
	"$selfillum" "1"
	"$selfillumtint" "[2 2 2]"
	"$selfillummask" "models\humans\guards_bmcer_sep2025/guard_accessories_si"

	"$normalmapalphaenvmapmask" "1"
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.85 0.90 1.3]"

        $detail detail\bm_metal_detail_01 // e.g. for brickwork, concrete...
        $detailscale 5
        $detailblendfactor 0.4
        $detailblendmode 0

        "$phong" "1"
        $phongexponent "30"
	"$phongboost" "10"
	"$phongalbedotint" "1"
	"$phongfresnelranges" "[0.5 0.7 1]"

        // Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"		// Exponent for phong component of rim lighting
	"$rimlightboost" ".5"			// Boost for ambient cube component of rim lighting
	
	
	"$model" 1
	
}


