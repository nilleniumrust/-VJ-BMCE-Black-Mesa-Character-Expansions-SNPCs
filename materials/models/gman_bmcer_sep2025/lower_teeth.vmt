"Teeth"
{
	"$basetexture" "models/gman_bmcer_sep2025/lower_teeth"
	"$model" 1
	"$clientshader" "MouthShader"
	"$halflambert" 1

// If you specify a bump map, you'll get specular
	"$bumpmap" "models/gman_bmcer_sep2025/lower_teeth_normal"
// This parameter overrides the alpha channel of the normal map (if any) to provide a phong exponent
	"$phongexponent" "100"
	"$nodecal" 1
}
