"VertexLitGeneric"
{
	"$baseTexture" "models\humans\scientists_bmcer_sep2025/scientist_m_cl_gibs"
	"$bumpmap" "models\humans\scientists_bmcer_sep2025/scientist_m_cl_normal"
	"$model" "1"
	"$surfaceprop" "flesh"
//	"$nocull" 1

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponenttexture" "models/humans/male_exponent"
	"$phongboost"	".25"
	"$phongfresnelranges"	"[0.05 0.5 1]"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" "1"	               // Boost for ambient cube component of rim lighting

	$detail models\humans\guards_bmcer_sep2025/clothes
	$detailscale 5
	$detailblendfactor 0.4
	$detailblendmode 0

}
