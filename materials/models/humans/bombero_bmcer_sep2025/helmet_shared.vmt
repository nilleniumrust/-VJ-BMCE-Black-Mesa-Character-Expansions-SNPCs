"VertexlitGeneric"
{
	"$basetexture" "models/humans/bombero_bmcer_sep2025/helmet_shared"
	"$bumpmap" "models/humans/bombero_bmcer_sep2025/helmet_shared_n"
	"$surfaceprop" "plastic"
	"$model" "1"
	"$phong"     "1"
	"$phongexponent"   "20"
	"$phongboost"   "20"
	"$phongfresnelranges"	"[.5 1 11]"
	"$phongalbedotint" "1"
	$nocull 1
	
//Restored cubemaps
	"$envmap" "env_cubemap"
//	"$envmaptint" "[.05 .05 .05]" //.2 .2 .2
	"$normalmapalphaenvmapmask" "1"
	
        $detail detail\bm_metal_detail_01 // e.g. for brickwork, concrete...
        $detailscale 10
        $detailblendfactor 0.4
        $detailblendmode 0

}
