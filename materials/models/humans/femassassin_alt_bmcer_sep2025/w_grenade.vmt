"VertexLitGeneric"
{
	"$baseTexture" "models\world_models/w_grenade"
	"$bumpmap" "models\world_models/w_grenade_normal"
	
	"$model" 1

	"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" 1
	"$envmaptint" "[ 0.1 0.1 0.1 ]"

	"$cloakpassenabled" "1"
	"$refractamount" "1"

	"Proxies"
	{
		"AssassinCloak"
		{
			"resultVar" "$cloakfactor"
		}

		"AssassinCloak"
		{
			"resultVar" "$refractamount"
		}
	}
}