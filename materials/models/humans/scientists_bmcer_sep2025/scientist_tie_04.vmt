"VertexLitGeneric"
{
	"$baseTexture" "models\humans\scientists_bmcer_sep2025/scientist_tie_04"
	"$bumpmap" "models\humans\worker_bmcer_sep2025/tie_normal"
	"$model" "1"
	"$surfaceprop" "flesh"
