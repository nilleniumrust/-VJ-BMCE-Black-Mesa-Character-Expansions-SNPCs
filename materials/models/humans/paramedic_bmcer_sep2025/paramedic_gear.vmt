"VertexLitGeneric"
{
	"$baseTexture" "models\humans/paramedic_bmcer_sep2025/paramedic_gear"
	"$bumpmap" "models\humans/paramedic_bmcer_sep2025/paramedic_gear_n"
 	"$model" "1"
		$BASEMAPLUMINANCEPHONGMASK 0
	"$phong"     "1"
	"$phongexponent"   "20"
	"$phongboost"   "20"
	"$phongfresnelranges"	"[.5 1 11]"
	"$phongalbedotint" "1"
