"VertexlitGeneric"
{
	"$basetexture" "models/world_models/w_crossbow_bolt"
	"$bumpmap" "models\world_models/w_crossbow_bolt_nm"
       	"$envmap" "env_cubemap"
       	"$envmaptint" "[1 1 1]"
    	"$normalmapalphaenvmapmask" "1"
	"$selfillum" "1"
// Phong Schtuff
"$phong" "1"
"$phongexponent" "50"

"$phongboost" "1"
