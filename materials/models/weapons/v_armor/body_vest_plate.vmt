"VertexLitGeneric"
{
	$basetexture "models\weapons\v_armor\body_vest_plate"
	$bumpmap "models\weapons\v_armor\body_vest_plate_norm"

	"$phong" 1
	"$phongexponent"   20
	"$phongboost"    .2
	"$phongfresnelranges"  "[0.7 0.7 0.7]"
	
	"$selfillum" 1
    "$selfillummask" "models\weapons\v_armor/body_vest_plate_illum"
	"$selfillum_envmapmask_alpha" 1
}