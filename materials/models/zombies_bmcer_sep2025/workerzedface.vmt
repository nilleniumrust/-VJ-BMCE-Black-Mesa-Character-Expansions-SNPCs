"VertexLitGeneric"
{
	"$baseTexture" "models\zombies_bmcer_sep2025/workerzedface"
	"$bumpmap" "models\zombies_bmcer_sep2025/workerzedface-nm"
	"$surfaceprop" "flesh"
	"$model" 1

     "$detail" 				"detail\noise_detail_01" // e.g. for brickwork, concrete...
	"$detailscale" 			"7.74"
	"$detailblendfactor"	"0.8"
	"$detailblendmode"		"0"

	"$phong"				"1"
	"$phongboost" 			"10"
	"$phongalbedotint" 		"1"
	"$phongfresnelranges" 	"[.18 .4 1]"
	"$halflambert"			"1"

	// Rim lighting parameters
	"$rimlight"				"1"		// To enable rim lighting (requires phong)
	"$rimlightexponent" 	"33"	// Exponent for phong component of rim lighting
	"$rimlightboost" 		"3"		// Boost for ambient cube component of rim lighting