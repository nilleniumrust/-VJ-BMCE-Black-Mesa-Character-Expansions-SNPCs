{
	"$basetexture"			"models/humans/femassassin_alt_bmcer_sep2025/GEAR"
	 "$bumpmap" 			"models/humans/femassassin_alt_bmcer_sep2025/GEAR_normal"

	 "$envmap" 			"env_cubemap"
	"$envmaptint"			"[ 0.36 0.36 0.36 ]"
	"$normalmapalphaenvmapmask"	"1"
	"$envmapsaturation" 0.7
	"$envmapcontrast" 0.3

	"$model" 1
	"$surfaceprop" "carpet"
	"$halflambert" 1

	"$cloakpassenabled" "1"
	"$refractamount" "1"

	"Proxies"
	{
		"AssassinCloak"
		{
			"resultVar" "$cloakfactor"
		}

		"AssassinCloak"
		{
			"resultVar" "$refractamount"
		}
	}
}
