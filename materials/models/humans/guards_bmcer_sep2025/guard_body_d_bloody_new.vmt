"VertexLitGeneric"
{
	"$baseTexture" "models\humans\guards_bmcer_sep2025/guard_body_d_bloody_new"
        "$bumpmap" "models\humans\guards_bmcer_sep2025/guard_body_n_new"
	"$surfaceprop" "flesh"

//        "$phong" "1"
//	"$phongboost" "1"
//	"$phongalbedotint" "1"
//	"$phongfresnelranges" "[.1 0.5 1]"
//	"$halflambert" "1"

        $phong 1
        $phongexponent 7
        $phongboost 1
        $phongtint "[1 1 1]"
        $halflambert 0
        $phongfresnelranges "[.4 .8 30]"

	// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "10"		// Exponent for phong component of rim lighting
	"$rimlightboost" ".1"			// Boost for ambient cube component of rim lighting

//	$detail "effects/models/model_blood_red.vtf"
//	$detailscale 5
//	$detailblendfactor 0.0
//	$detailblendmode 0
	$detail models\humans\guards_bmcer_sep2025/clothes
	$detailscale "[ 5 10 ]"
	$detailblendfactor 0.4
	$detailblendmode 0
	Proxies
	{
		ModelDetailFx
		{
		}
	}
	
	"$model" 1
	
}