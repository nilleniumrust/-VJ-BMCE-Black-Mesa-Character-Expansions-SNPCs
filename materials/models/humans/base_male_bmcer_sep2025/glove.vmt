"VertexLitGeneric"
{
	"$baseTexture" "models\humans\base_male_bmcer_sep2025/glove"
	"$bumpmap"	   "models\humans\base_male_bmcer_sep2025/glove_normal"
	"$nodecal" "1"
	"$model" "1"
	"$surfaceprop" "flesh"
	$nocull 1

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponent" "4"
//	"$phongalbedotint" "1"
	"$phongboost" ".5"
	"$phongfresnelranges"	"[.3 .3 .3]"

// Rim lighting parameters
	"$rimlight" "0"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".1"	               // Boost for ambient cube component of rim lighting
	
        $detail detail\bm_metal_detail_01 // e.g. for brickwork, concrete...
        $detailscale 10
        $detailblendfactor 0.75
        $detailblendmode 0
}
