"VertexLitGeneric"
{
	"$basetexture" "models\weapons\v_crossbow\xbow_base_diff"
	"$bumpmap" "models\weapons\v_crossbow\xbow_base_nm"
	
	"$model" 1

	"$HALFLAMBERT_GBUFFER_OFF" "1"

//metal
	$envmap "env_cubemap"
	//$basealphaenvmapmask 1
		$normalmapalphaenvmapmask 1
	$envmaptint "[.1 .1 .1]"
		$envmapcontrast 1
			$envmapsaturation 0.1
