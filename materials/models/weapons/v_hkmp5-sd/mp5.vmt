"VertexLitGeneric"
{
	"$basetexture" "models\weapons\v_hkmp5-sd/mp5"
	"$bumpmap" "models\weapons\v_hkmp5-sd/mp5_normals"
	
	"$model" 1

	"$HALFLAMBERT_GBUFFER_OFF" "1"

//metal
	"$normalmapalphaenvmapmask" 1
	"$envmap" "env_cubemap"
	"$envmapsaturation" .7
	"$envmapcontrast" 1
	"$envmaptint" "[0.235 0.235 0.235]"

	"$phong" "1"
	"$phongexponent" "30"
	"$phongboost" "7"
	"$phongfresnelranges"	"[0.4 0.9 2.6]"
	"$phongalbedotint" "1"
	"$normalmapAlphaPhongMask" "1"

	// Emissive parameters.
	$emissiveBlendEnabled 1
	$emissiveBlendTexture "vgui\white"
	$emissiveBlendBaseTexture "models\weapons\v_hkmp5-sd/mp5_selfilum"
	$emissiveBlendFlowTexture "vgui\white"
	$emissiveBlendTint "{255 255 255}"
	$emissiveBlendStrength .2
	$emissiveBlendScrollVector "[0 0]"


	"$halflambert"			"1"
	"$rimlight"               "1"
	"$rimlightexponent"       "100"
	"$rimlightboost"          ".5"
	"$rimmask"			"1"

// 	$detail "effects/models/model_blood_red.vtf"
	$detailscale 5
	$detailblendfactor 0.0
	$detailblendmode 0
	Proxies
	{
		ModelDetailFx
		{
		}
	}
 }