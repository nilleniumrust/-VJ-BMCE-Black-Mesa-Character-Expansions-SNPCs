
vertexlitgeneric
{

	$basetexture models\humans\osha_bmcer_sep2025/gta_jacket_02_hurt
	$bumpmap models\humans\guards_bmcer_sep2025/ranger_jacket_new_normal
	$lightwarptexture dev/identitylightwarp
	
	$halflambert 1
	$ambientocclusion 1
	$nocull 1

	$detail models\humans\guards_bmcer_sep2025/clothes
	$detailscale 6
	$detailblendfactor 0.6
	$detailblendmode 0

    $phong 1
    $phongexponent 5
    $phongboost 10 //.025
    $phongfresnelranges "[.4 .8 30]"
	"$phongalbedotint" "1"
	"$phongexponenttexture" "models\ninja_bmcer_sep2025/L4D2/exp"
	
// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" "10"	//3               // Boost for ambient cube component of rim lighting

}
