"VertexLitGeneric"
{
	$basetexture "models/weapons/weapon_gibs/9mmclip_low"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.10 .10 .10]"
	
	"$model" 1

	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "4"
	"$phongfresnelranges"	"[.5 1 1]"
	"$phongalbedotint" "1"

	"$rimlight" "1"
	"$rimlightexponent" "25"
	"$rimlightboost" "0.125"
	
	"$tintA" "[5 3 1]"
	"$tintB" "[.15 .15 .15]"	

	Proxies
	{
		ModelDetailFx
		{
		}

		"FlashyWeapon"
		{
			"resultVar" "$tintB"
		}
		"Multiply"
		{
			"srcVar1" "$tintA"
			"srcVar2" "$tintB"
			"resultVar" "$selfillumtint"
		}
	}
}