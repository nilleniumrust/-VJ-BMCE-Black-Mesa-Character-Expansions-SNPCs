"VertexLitGeneric"
{
	"$baseTexture" "models/humans/guards_bmcer_sep2025/soldier_sargehat"
	"$bumpmap" "models/humans/guards_bmcer_sep2025/soldier_sargehat_normal"
	"$surfaceprop" "flesh"

	
// -- From here down is new stuff which will only be applied if $phong is set to 1 --
    $phong 1
    $phongexponent 7
    $phongboost 1
    $phongtint "[1 1 1]"
    $halflambert 1    
    $phongfresnelranges "[.4 .8 30]"

// Rim lighting parameters
	"$rimlight" "1"				// To enable rim lighting (requires phong)
	"$rimlightexponent" "80"             // Exponent for phong component of rim lighting
	"$rimlightboost" ".1"	               // Boost for ambient cube component of rim lighting

//	$detail "effects/models/model_blood_red.vtf"
	$detail models\humans\guards_bmcer_sep2025/clothes
	$detailscale 2
	$detailblendfactor 0.9
	$detailblendmode 0
	Proxies
	{
		ModelDetailFx
		{
		}
	}
}