"$phongexponent" "5"
"$phongboost" "5"
"$phongfresnelranges"	"[0.2 .5 1.6]"
"$phongalbedotint" "1"


// Rim lighting parameters
"$rimlight" "1"
"$rimlightexponent" "25"
"$rimlightboost" "0.5"
    "$model" 1
}