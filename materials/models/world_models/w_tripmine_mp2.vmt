//"EDITOR_SHADER"
"VertexLitGeneric"
{
	"$SHADERNAME" "model_standard"

	"$baseTexture" "models\weapons\v_tripmine/tripmine2"
	"$bumpmap" "models\weapons\v_tripmine/tripmine2_normal"
	
	"$model" 1

//metal
	"$normalmapalphaenvmapmask" "1"
	"$envmap" "env_cubemap"
	"$basealphaenvmapmask" "0"
	"$envmaptint" "[.1 .1 .1]"

	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" "1"
	"$phongfresnelranges"	"[0.4 0.9 2.6]"
	"$phongalbedotint" "1"

	// Rim lighting parameters
	"$rimlight" "1"
	"$rimlightexponent" "25"
	"$rimlightboost" "0.1"
	
	"$sheenPassEnabled" "1"
	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"
	
	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"160"
		}
	}
}
